---
export interface Props {
  title: string;
}

const { title } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="The Oddship - We rebuild ourselves at sea" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <link rel="stylesheet" href="/css/style.css" />
    <script is:inline defer src="https://analytics.rohanverma.net/script.js" data-website-id="3c773110-c16d-411e-a7ba-063f0178d18f"></script>
  </head>
  <body>
    <nav>
      <a href="/" aria-current={currentPath === "/" ? "page" : undefined}>home</a>
      <a href="/about" aria-current={currentPath.startsWith("/about") ? "page" : undefined}>about</a>
      <a href="/chronicles" aria-current={currentPath === "/chronicles" ? "page" : undefined}>chronicles</a>
    </nav>

    <main class="content">
      <slot />
    </main>

    <footer>
      oddship.net
    </footer>
  </body>
</html>
